<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>177dfab5-b682-40a3-a61a-1273f82c9b4e</UserSecretsId>
    <!-- 未署名のネイティブ起動スタブ(apphost/Goen.Api.exe)を生成しない。
         Windowsのスマートアプリコントロールが未署名exeをブロックする環境のため、
         署名済みの dotnet.exe が直接 Goen.Api.dll を読み込む形で起動させる。 -->
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Goen.Infrastructure\Goen.Infrastructure.csproj" />
    <ProjectReference Include="..\Goen.Domain\Goen.Domain.csproj" />
  </ItemGroup>

</Project>
